<div class="section" style="display:flex; justify-content:space-between; align-items:flex-start;">
  <div>
    <h1>Comprobante de pago</h1>
    <p style="color:#6b7280">Fecha de emisión: {{formatDate invoice.issueDate 'dd MMM yyyy'}}</p>
  </div>
  <div style="text-align:right">
    <p style="color:#6b7280">Comprobante N.° {{invoice.number}}</p>
  </div>
</div>

<div class="section" style="display:flex; justify-content:space-between; gap:24px;">
  <div style="flex:1">
    <div class="section-title" style="margin:0 0 6px 0; border-bottom:0; font-size:12px; text-transform:uppercase; color:#6b7280;">De</div>
    <p style="font-weight:700; color:#111827">{{seller.name}}</p>
    {{#if seller.address}}<p>{{seller.address}}</p>{{/if}}
    {{#if seller.email}}<p>{{seller.email}}</p>{{/if}}
    {{#if seller.phone}}<p>{{seller.phone}}</p>{{/if}}
  </div>
  <div style="flex:1">
    <div class="section-title" style="margin:0 0 6px 0; border-bottom:0; font-size:12px; text-transform:uppercase; color:#6b7280;">Facturado a</div>
    <p style="font-weight:700; color:#111827">{{buyer.name}}</p>
    {{#if buyer.address}}<p>{{buyer.address}}</p>{{/if}}
    {{#if buyer.email}}<p>{{buyer.email}}</p>{{/if}}
    {{#if buyer.phone}}<p>{{buyer.phone}}</p>{{/if}}
  </div>
</div>

<div class="section">
  <h2 class="section-title">Detalle</h2>
  <table>
    <thead>
      <tr>
        <th>Descripción</th>
        <th style="text-align:right">Cant.</th>
        <th style="text-align:right">Precio</th>
        <th style="text-align:right">Subtotal</th>
      </tr>
    </thead>
    <tbody>
      {{#each invoice.items}}
        <tr>
          <td>{{this.description}}</td>
          <td style="text-align:right">{{this.quantity}}</td>
          <td style="text-align:right">{{formatCurrency this.unitPrice ../invoice.currency}}</td>
          <td style="text-align:right">{{formatCurrency (multiply this.quantity this.unitPrice) ../invoice.currency}}</td>
        </tr>
      {{/each}}
    </tbody>
  </table>

  <div style="margin-top:12px; display:flex; justify-content:flex-end">
    <table class="totals">
      <tr><td>Subtotal</td><td style="text-align:right">{{formatCurrency invoice.subtotal invoice.currency}}</td></tr>
      <tr><td>Impuestos</td><td style="text-align:right">{{formatCurrency invoice.taxes invoice.currency}}</td></tr>
      <tr class="grand"><td>Total</td><td style="text-align:right">{{formatCurrency invoice.total invoice.currency}}</td></tr>
    </table>
  </div>
</div>

<div class="section">
  <h2 class="section-title">Pago</h2>
  <p>Método: {{invoice.paymentMethod}}</p>
  <p>Emitido: {{formatDate invoice.issueDate 'dd MMM yyyy HH:mm'}}</p>
  {{#if invoice.externalReference}}<p>Referencia externa: {{invoice.externalReference}}</p>{{/if}}
  {{#if invoice.providerId}}<p>ID del proveedor de pago: {{invoice.providerId}}</p>{{/if}}
</div>

<div class="section">
  <p style="font-size:12px; color:#6b7280">Este documento es una representación visual del comprobante de pago generado por EthicVoice. Cuando aplique, se emiten facturas electrónicas numeradas conforme a la normativa DIAN. Conserva este documento para tus registros.</p>
</div>
