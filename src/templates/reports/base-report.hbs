<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{{title}} - EthicVoice</title>
    <style>
      @page {
        size: A4;
        margin: 0;
      }
      :root {
        --ev-forest: #0a1e14;
        --ev-ink: #0d212c;
        --ev-mint: #f7faf9;
        --ev-lime: #a3e635;
        --ev-lime-dark: #65a30d;
        --ev-emerald: #10b981;
        --ev-border: #e3e8e5;
      }
      body {
        margin: 0;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: var(--ev-ink);
        background: #ffffff;
        line-height: 1.5;
      }
      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        box-sizing: border-box;
      }
      .page-body {
        padding: 14mm 16mm 16mm 16mm;
      }
      h1 {
        font-size: 21px;
        font-weight: 800;
        color: #111;
        margin: 0 0 4mm 0;
        letter-spacing: -0.01em;
      }
      h2 {
        font-size: 14px;
        font-weight: 700;
        color: var(--ev-ink);
        margin: 8mm 0 3mm 0;
        display: flex;
        align-items: center;
        gap: 2.5mm;
      }
      h2::before {
        content: "";
        display: inline-block;
        width: 3mm;
        height: 3mm;
        border-radius: 1px;
        background: var(--ev-lime);
        flex-shrink: 0;
      }
      h3 {
        font-size: 12px;
        font-weight: 700;
        color: #222;
        margin: 5mm 0 2mm 0;
      }
      p {
        font-size: 11px;
        color: #3a4441;
        margin: 0 0 3mm 0;
      }

      /* Brand header: dark band with a lime accent rule underneath */
      .brand-strip {
        height: 3mm;
        background: linear-gradient(
          90deg,
          var(--ev-lime) 0%,
          var(--ev-emerald) 100%
        );
      }
      .header {
        background: var(--ev-forest);
        color: #fff;
        padding: 8mm 16mm;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10mm;
      }
      .header-left {
        display: flex;
        align-items: center;
        gap: 6mm;
      }
      .logo-container {
        width: 20mm;
        height: 20mm;
        background: #fff;
        border-radius: 3mm;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        padding: 2mm;
      }
      .logo {
        width: 100%;
        height: 100%;
        object-fit: contain;
      }
      .header-content h1 {
        color: #fff;
        margin: 0 0 1.5mm 0;
        font-size: 21px;
      }
      .header-subtitle {
        color: rgba(255, 255, 255, 0.68);
        font-size: 11px;
        margin: 0;
      }
      .header-right {
        text-align: right;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 2mm;
      }
      .org-logo {
        width: 16mm;
        height: 16mm;
        object-fit: contain;
        background: #fff;
        border-radius: 2mm;
        padding: 1.5mm;
      }
      .org-name {
        font-size: 13px;
        font-weight: 700;
        color: var(--ev-lime);
        margin: 0;
      }
      .report-meta {
        font-size: 9.5px;
        color: rgba(255, 255, 255, 0.6);
        margin: 0;
      }

      .section {
        margin-bottom: 9mm;
        page-break-inside: avoid;
      }

      /* Tables: plain, brand-accented header */
      table {
        width: 100%;
        border-collapse: collapse;
        margin: 4mm 0;
      }
      th,
      td {
        font-size: 10.5px;
        padding: 3mm 2.5mm;
        border-bottom: 1px solid var(--ev-border);
        text-align: left;
      }
      th {
        background: var(--ev-mint);
        font-weight: 700;
        color: var(--ev-forest);
        text-transform: uppercase;
        font-size: 9.5px;
        letter-spacing: 0.03em;
        border-bottom: 1.5px solid var(--ev-lime);
      }
      tr:last-child td {
        border-bottom: 0;
      }

      /* Simple panels and grids */
      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6mm;
      }
      .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6mm;
      }
      .panel {
        border: 1px solid var(--ev-border);
        border-top: 2.5px solid var(--ev-lime);
        border-radius: 2px;
        padding: 5mm;
        background: #fff;
      }
      .panel-h {
        border-bottom: 1px solid var(--ev-border);
        margin-bottom: 3mm;
      }
      .panel-b {
      }

      .kpi {
        background: var(--ev-mint);
        border-top: 2.5px solid var(--ev-lime);
        border-radius: 2px;
        padding: 4mm 5mm;
      }
      .kpi .label {
        font-size: 9.5px;
        color: #4b5a54;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        font-weight: 600;
      }
      .kpi .value {
        font-size: 18px;
        font-weight: 800;
        color: var(--ev-forest);
      }
      .kpi .note {
        font-size: 9.5px;
        color: #667;
      }

      .footer {
        margin-top: 12mm;
        padding: 4mm 16mm 6mm 16mm;
        border-top: 2px solid var(--ev-lime);
      }
      .footer-content {
        display: flex;
        justify-content: space-between;
        font-size: 9.5px;
        color: #5a6a63;
      }
      .footer-content strong {
        color: var(--ev-forest);
      }

      @media print {
        .page-body {
          padding: 12mm 15mm;
        }
        .section {
          page-break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="brand-strip"></div>
      <div class="header">
        <div class="header-left">
          <div class="logo-container">
            {{#if ethicVoiceLogo}}
              <img src="{{ethicVoiceLogo}}" alt="EthicVoice" class="logo" />
            {{/if}}
          </div>
          <div class="header-content">
            <h1>{{title}}</h1>
            <p class="header-subtitle">{{subtitle}}</p>
          </div>
        </div>
        <div class="header-right">
          {{#if organizationLogo}}
            <img
              src="{{organizationLogo}}"
              alt="{{organizationName}}"
              class="org-logo"
            />
          {{/if}}
          {{#if organizationName}}
            <div class="org-name">{{organizationName}}</div>
          {{/if}}
          <div class="report-meta">Generado:
            {{formatDate generatedAt "dd/MM/yyyy HH:mm"}}</div>
        </div>
      </div>

      <div class="page-body">
        {{{content}}}
      </div>

      <div class="footer">
        <div class="footer-content">
          <div><strong>EthicVoice</strong> Analytics • {{reportId}}</div>
          <div>Confidencial • {{formatDate generatedAt "yyyy"}}</div>
        </div>
      </div>
    </div>
  </body>
</html>
