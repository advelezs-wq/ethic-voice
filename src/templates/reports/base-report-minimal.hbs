<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>{{title}} - EthicVoice</title>
    <style>
      @page {
        size: A4;
        margin: 16mm 16mm 18mm 16mm;
      }
      * {
        box-sizing: border-box;
      }
      :root {
        --ev-forest: #0a1e14;
        --ev-ink: #0d212c;
        --ev-mint: #f7faf9;
        --ev-lime: #a3e635;
        --ev-emerald: #10b981;
        --ev-border: #e3e8e5;
      }
      body {
        font-family:
          Inter,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: var(--ev-ink);
        margin: 0;
      }
      h1 {
        font-size: 19px;
        margin: 0 0 2mm 0;
        font-weight: 800;
        color: #fff;
      }
      h2 {
        font-size: 12.5px;
        margin: 0 0 4mm 0;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        color: var(--ev-forest);
        display: flex;
        align-items: center;
        gap: 2.5mm;
      }
      h2::before {
        content: "";
        display: inline-block;
        width: 2.6mm;
        height: 2.6mm;
        border-radius: 1px;
        background: var(--ev-lime);
        flex-shrink: 0;
      }
      h3 {
        font-size: 11.5px;
        margin: 0 0 2mm 0;
        font-weight: 700;
        color: #333;
      }
      p,
      li,
      td,
      th {
        font-size: 10.5px;
        line-height: 1.45;
      }

      /* Fixed brand header on every page */
      .fixed-header {
        position: fixed;
        top: 0;
        left: -16mm;
        right: -16mm;
        height: 28mm;
        padding: 6mm 16mm;
        background: var(--ev-forest);
        border-bottom: 3px solid var(--ev-lime);
        z-index: 10;
      }
      .header-inner {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6mm;
        align-items: center;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 4mm;
      }
      .meta {
        text-align: right;
        color: rgba(255, 255, 255, 0.65);
        font-size: 9.5px;
      }
      .meta .stack {
        display: flex;
        flex-direction: column;
        gap: 2mm;
        align-items: flex-end;
      }
      .brand-logo {
        height: 9mm;
        width: auto;
        object-fit: contain;
        background: #fff;
        border-radius: 1.5mm;
        padding: 1mm 2mm;
      }
      .muted {
        color: #667;
      }
      .header-inner .muted {
        color: rgba(255, 255, 255, 0.68);
      }

      .page-content {
        position: relative;
        z-index: 0;
        margin-top: 32mm;
        padding-top: 4mm;
      }

      .divider {
        height: 1px;
        background: var(--ev-border);
        margin: 6mm 0;
      }

      .grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6mm;
      }
      .grid-3 {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 6mm;
      }
      .grid-4 {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6mm;
      }

      .panel {
        padding: 0;
        border: 1px solid var(--ev-border);
        border-top: 2.5px solid var(--ev-lime);
        border-radius: 4px;
      }
      .panel .panel-h {
        padding: 4mm;
        border-bottom: 1px solid var(--ev-border);
        background: var(--ev-mint);
      }
      .panel .panel-b {
        padding: 4mm;
      }

      table {
        width: 100%;
        border-collapse: collapse;
      }
      th,
      td {
        border-bottom: 1px solid #eee;
        padding: 3mm 2mm;
        text-align: left;
      }
      th {
        font-size: 9.5px;
        color: var(--ev-forest);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        background: var(--ev-mint);
        border-bottom: 1.5px solid var(--ev-lime);
      }

      .kpi {
        display: grid;
        gap: 1mm;
      }
      .kpi .label {
        color: #667;
        font-size: 9.5px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
      }
      .kpi .value {
        font-size: 17px;
        font-weight: 800;
        color: var(--ev-forest);
      }
      .kpi .note {
        color: #667;
        font-size: 9.5px;
      }

      .legend {
        display: grid;
        gap: 2mm;
      }
      .legend .row {
        display: flex;
        align-items: center;
        gap: 3mm;
      }
      .box {
        width: 8px;
        height: 8px;
        background: var(--ev-lime);
        border-radius: 1px;
      }

      .bar {
        height: 8px;
        background: var(--ev-border);
        border-radius: 2px;
        overflow: hidden;
      }
      .bar > span {
        display: block;
        height: 100%;
        background: linear-gradient(
          90deg,
          var(--ev-lime) 0%,
          var(--ev-emerald) 100%
        );
      }

      .mono {
        font-family:
          ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
          "Liberation Mono", "Courier New", monospace;
      }

      .footer {
        margin-top: 10mm;
        padding-top: 4mm;
        border-top: 2px solid var(--ev-lime);
        color: #5a6a63;
        font-size: 9.5px;
        display: flex;
        justify-content: space-between;
      }
      .footer strong {
        color: var(--ev-forest);
      }
    </style>
  </head>
  <body>
    <div class="fixed-header">
      <div class="header-inner">
        <div class="brand">
          <div>
            <h1>{{title}}</h1>
            <div class="muted">{{subtitle}}</div>
          </div>
        </div>
        <div class="meta">
          <div class="stack">
            {{#if ethicVoiceLogo}}<img
                src="{{ethicVoiceLogo}}"
                alt="EthicVoice"
                class="brand-logo"
              />{{/if}}
            <div>Generado: {{formatDate generatedAt "dd/MM/yyyy HH:mm"}}</div>
          </div>
        </div>
      </div>
    </div>

    <div class="page-content">
      {{{content}}}

      <div class="footer">
        <div><strong>EthicVoice</strong> • Confidencial</div>
        <div>{{formatDate generatedAt "yyyy"}}</div>
      </div>
    </div>
  </body>
</html>
