<html lang="es">
  <head>
    <meta charset="utf-8" />
    <title>Comprobante de pago - EthicVoice</title>
    <style>
      @page {
        size: A4;
        margin: 0;
      }
      :root {
        --ev-forest: #0a1e14;
        --ev-ink: #111827;
        --ev-lime: #a3e635;
        --ev-emerald: #10b981;
        --ev-border: #e5e7eb;
      }

      body {
        margin: 0;
        font-family:
          "Inter",
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
        color: var(--ev-ink);
        background: #ffffff;
        line-height: 1.6;
        font-size: 14px;
      }

      .page {
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto;
        box-sizing: border-box;
      }

      .brand-strip {
        height: 3mm;
        background: linear-gradient(
          90deg,
          var(--ev-lime) 0%,
          var(--ev-emerald) 100%
        );
      }

      .page-body {
        padding: 16mm 20mm 20mm 20mm;
      }

      h1 {
        font-size: 26px;
        font-weight: 800;
        margin: 0 0 6px 0;
        color: var(--ev-forest);
      }
      h2 {
        font-size: 18px;
        font-weight: 700;
        margin: 24px 0 12px 0;
        color: var(--ev-forest);
      }
      p {
        margin: 0 0 6px 0;
        color: #374151;
      }

      .section {
        margin-bottom: 24px;
        page-break-inside: avoid;
      }
      .section-title {
        font-size: 16px;
        font-weight: 700;
        color: var(--ev-forest);
        margin: 0 0 10px 0;
        padding-bottom: 6px;
        border-bottom: 2px solid var(--ev-lime);
      }

      /* Tables: neutral, brand-accented header */
      table {
        width: 100%;
        border-collapse: collapse;
      }
      th,
      td {
        padding: 8px 4px;
        border-bottom: 1px solid var(--ev-border);
      }
      th {
        text-align: left;
        font-size: 11px;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--ev-forest);
        font-weight: 700;
        background: #f7faf9;
        border-bottom: 1.5px solid var(--ev-lime);
      }

      .totals {
        width: 320px;
        font-size: 14px;
      }
      .totals td {
        border: 0;
        padding: 6px 0;
      }
      .totals .grand td {
        font-weight: 800;
        color: var(--ev-forest);
        border-top: 1.5px solid var(--ev-lime);
        padding-top: 8px;
      }

      /* Header logo band */
      .header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 20px;
        padding-bottom: 14px;
        border-bottom: 1px solid var(--ev-border);
      }
      .brand {
        height: 34px;
      }
      .header-doc-label {
        text-align: right;
        font-size: 11px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #6b7280;
        font-weight: 700;
      }

      /* Footer */
      .footer {
        margin-top: 40px;
        padding-top: 12px;
        border-top: 2px solid var(--ev-lime);
        font-size: 12px;
        color: #6b7280;
      }
      .footer strong {
        color: var(--ev-forest);
      }

      @media print {
        .page-body {
          padding: 15mm 15mm;
        }
        .section {
          page-break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <div class="page">
      <div class="brand-strip"></div>
      <div class="page-body">
        <div class="header">
          {{#if ethicVoiceLogo}}
            <img class="brand" src="{{ethicVoiceLogo}}" alt="EthicVoice" />
          {{/if}}
          <div class="header-doc-label">Comprobante de pago</div>
        </div>
        {{{content}}}
        <div class="footer">
          <strong>EthicVoice</strong> • Documento generado automáticamente. Conserva
          este comprobante para tus registros contables.
        </div>
      </div>
    </div>
  </body>
</html>
